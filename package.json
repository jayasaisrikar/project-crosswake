{
  "name": "crosswake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "collect": "tsx apps/collector/src/main.ts",
    "history": "tsx apps/history/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:build": "tsx scripts/build-performance.ts",
    "perf:delay": "tsx scripts/fill-delay.ts",
    "log:verify": "tsx scripts/verify-signal-log.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "replay": "tsx apps/replay/src/main.ts",
    "backtest": "tsx apps/research/src/main.ts",
    "data:quality": "tsx apps/quality/src/main.ts",
    "research:freeze": "tsx apps/evaluation/src/main.ts freeze",
    "research:walk-forward": "tsx apps/evaluation/src/main.ts walk-forward",
    "research:holdout": "tsx apps/evaluation/src/main.ts holdout",
    "paper:replay": "tsx apps/paper/src/main.ts",
    "research:supervisor": "tsx apps/supervisor/src/main.ts",
    "research:experiment": "tsx apps/supervisor/src/experiment.ts",
    "research:api": "tsx apps/api/src/main.ts",
    "dashboard": "pnpm --filter @crosswake/dashboard dev",
    "dashboard:build": "pnpm --filter @crosswake/dashboard build",
    "context:collect": "tsx apps/context/src/main.ts",
    "typecheck:dashboard": "tsc --noEmit -p apps/dashboard/tsconfig.json",
    "typecheck:landing": "tsc --noEmit -p apps/landing/tsconfig.json",
    "ops:report": "tsx apps/operations/src/main.ts",
    "residual:history": "tsx apps/residual/src/main.ts history",
    "residual:backtest": "tsx apps/residual/src/main.ts backtest",
    "residual:walk-forward": "tsx apps/residual/src/main.ts walk-forward",
    "residual:holdout": "tsx apps/residual/src/main.ts holdout",
    "residual:live": "tsx apps/residual/src/main.ts live",
    "residual:study": "tsx apps/residual/src/main.ts study",
    "costs:sample": "tsx apps/costs/src/main.ts sample",
    "costs:report": "tsx apps/costs/src/main.ts report",
    "services:install": "scripts/services.sh install",
    "services:uninstall": "scripts/services.sh uninstall",
    "services:status": "scripts/services.sh status",
    "services:restart": "scripts/services.sh restart",
    "services:logs": "scripts/services.sh logs",
    "trend:history": "tsx apps/trend/src/main.ts history",
    "trend:test": "tsx apps/trend/src/main.ts test",
    "trend:live": "tsx apps/trend/src/main.ts live",
    "htf:history": "tsx apps/htf/src/main.ts history",
    "htf:test": "tsx apps/htf/src/main.ts test",
    "htf:live": "tsx apps/htf/src/main.ts live",
    "digest:live": "tsx apps/digest/src/main.ts",
    "status:live": "tsx apps/status/src/main.ts",
    "status:preview": "tsx apps/status/src/main.ts --dry-run",
    "venue:check": "tsx apps/venue/src/main.ts",
    "data:retention": "tsx apps/retention/src/main.ts",
    "commerce:demo": "tsx apps/commerce/src/main.ts demo",
    "commerce:run": "tsx apps/commerce/src/main.ts run",
    "commerce:providers": "tsx apps/commerce/src/main.ts providers",
    "commerce:offers": "tsx apps/commerce/src/main.ts offers",
    "commerce:budget": "tsx apps/commerce/src/main.ts budget",
    "commerce:purchases": "tsx apps/commerce/src/main.ts purchases",
    "commerce:purchase": "tsx apps/commerce/src/main.ts purchase",
    "commerce:audit": "tsx apps/commerce/src/main.ts audit",
    "commerce:approve": "tsx apps/commerce/src/main.ts approve",
    "commerce:decline": "tsx apps/commerce/src/main.ts decline",
    "commerce:execute": "tsx apps/commerce/src/main.ts execute",
    "commerce:reconcile": "tsx apps/commerce/src/main.ts reconcile",
    "commerce:disable": "tsx apps/commerce/src/main.ts disable",
    "commerce:enable": "tsx apps/commerce/src/main.ts enable",
    "commerce:evaluate": "tsx apps/commerce/src/main.ts evaluate",
    "commerce:agent": "tsx apps/commerce/src/main.ts agent"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.86",
    "@duckdb/node-api": "1.5.6-r.1",
    "@mastra/core": "1.74.0",
    "@mastra/libsql": "1.25.0",
    "@mastra/memory": "1.35.0",
    "ai": "^7.0.130",
    "pino": "^10.0.0",
    "unzipper": "^0.12.3",
    "viem": "^2.57.4",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
