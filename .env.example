# Public market data requires no execution keys.
DATA_DIR=./data
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_SPOT_WS_BASE=wss://stream.binance.com:9443
LATENESS_MS=7000
QUOTE_MAX_AGE_MS=5000
# Timestamped supplemental context (no automatic strategy influence)
ALTFINS_API_KEY=

# Persist exploratory signal/paper ledgers; off collects market data only.
PAPER_MODE=shadow
STRATEGY_CONFIG=configs/catch-up-v001.json

# Mastra Research Supervisor: provider/model ID, with the provider's key in your environment.
# No default model and no automatic paid inference.
RESEARCH_MODEL=
# Example provider key variable (leave unset until you choose that provider).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OpenCode Go gateway (Responses API). Use RESEARCH_MODEL=opencode/<gateway-model-id>.
# OPENCODE_API_KEY=
RESEARCH_API_PORT=4112
# Set only when the dashboard runs off-box (e.g. Vercel) and must reach this evidence
# API over the network. Absolute http(s) base URL; overrides RESEARCH_API_PORT.
# RESEARCH_API_BASE=https://crosswake-api.example.com

# --- Agentic commerce (research purchasing agent) -------------------------------
# mock | testnet | mainnet. Mainnet additionally needs COMMERCE_MAINNET_ENABLED=true
# AND a separate mainnet key AND a recorded human approval per purchase.
COMMERCE_MODE=mock
COMMERCE_MAINNET_ENABLED=false
COMMERCE_ASSET=SOLUSDT
COMMERCE_POLICY=configs/commerce/policy.json
COMMERCE_REGISTRY=configs/commerce/providers.json
# Dedicated test wallet for Base Sepolia (never reuse a mainnet key here).
# COMMERCE_TESTNET_WALLET_PRIVATE_KEY=
# COMMERCE_MAINNET_WALLET_PRIVATE_KEY=
# COMMERCE_RPC_URL=https://sepolia.base.org

